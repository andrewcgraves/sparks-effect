# RabbitMQ connection string for the routing queue. Required — a worker with no
# queue has nothing to consume, so an empty value is a startup failure rather
# than a degraded mode.
AMQP_URL=

# Queue routing jobs arrive on. Must match what sparks-effect-api publishes to.
# Defaults to routing.jobs; leave unset unless both sides are being changed.
ROUTING_QUEUE=

# Queue that exhausted jobs are moved to. Nothing consumes it; it exists so a
# job that ran out of retries is inspectable rather than discarded.
# Defaults to routing.jobs.dead.
ROUTING_DEAD_LETTER_QUEUE=

# How many times a transient failure is redelivered before the job is
# dead-lettered and marked failed. Defaults to 3. Zero is a valid setting and
# means fail on the first transient error.
ROUTING_MAX_RETRIES=

# sparks-effect-api base URL. Required — the worker records job results and
# reuses egress polygons through authenticated endpoints on the API rather
# than connecting to Postgres (SPA-273).
API_URL=

# Shared bearer token the API's worker endpoints accept. Must match
# WORKER_TOKEN on the API. Required; a missing or rejected token is a
# startup failure rather than a degraded mode.
WORKER_TOKEN=

# Timeout for a single API call, in seconds. Defaults to 30.
API_TIMEOUT_SECONDS=

# Valhalla base URL, e.g. http://valhalla:8002 — the in-cluster ClusterIP
# service. There is no API key: the network is the authorization.
#
# When UNSET the worker serves SYNTHETIC isochrones (circles sized from the
# budget) instead of real ones, so the whole loop runs in seconds with no
# tileset. Right for local development, seriously wrong in production.
VALHALLA_URL=

# Timeout for a single Valhalla call, in seconds. Defaults to 30.
VALHALLA_TIMEOUT_SECONDS=

# --- Routing limits ---
# Defaulted to what the deployed container enforces; see README.md. Set these
# only when the Valhalla deployment's own limits are changed.

# Maximum isochrone time contour, in minutes. Defaults to 320, matching the
# patched service_limits.isochrone.max_time_contour.
VALHALLA_MAX_ISO_CONTOUR_MINS=

# Maximum matrix sources × targets. Defaults to 2500, Valhalla's own
# max_matrix_location_pairs (matrix limits are not patched).
VALHALLA_MAX_MATRIX_PAIRS=

# Maximum b-line distance between a matrix source and target, in km, by costing.
# Default to Valhalla's max_matrix_distance: 400 for auto, 200 for the rest.
VALHALLA_MATRIX_BLINE_AUTO_KM=
VALHALLA_MATRIX_BLINE_OTHER_KM=

# How many Valhalla requests one chain may have in flight at once. Not a
# Valhalla limit — a bound on the egress fan-out and, for transit mode, on
# pairwise /route access calls, so one chain cannot oversubscribe a small
# server. Defaults to 8.
VALHALLA_MAX_CONCURRENCY=

# Logs are structured JSON (one object per line) at every level. Set
# LOG_LEVEL=debug (or VERBOSE=true) to also emit per-job debug detail —
# node counts, cache hits, per-candidate routing decisions. Unset (or any
# other value) stays at info: job lifecycle and routing decisions only.
LOG_LEVEL=
